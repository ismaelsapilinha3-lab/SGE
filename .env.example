APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sge_multitel
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_NOME="Administrador SGE"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=
# Origens exactas (separadas por vírgula) autorizadas a falar com a API.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Expressões regulares (separadas por vírgula) para aceitar famílias de origens.
# Por omissão aceita qualquer porta local (dev server do Angular usa portas efémeras).
CORS_ALLOWED_ORIGIN_PATTERNS={^https?://(localhost|127\.0\.0\.1)(:\d+)?$}
# Expiração dos tokens Sanctum, em minutos (30 dias).
SANCTUM_EXPIRATION=43200

# Envio de SMS (aceitação da candidatura).
# provider: simulado (teste local, sem chamadas externas), http, twilio
SMS_ENABLED=true
SMS_PROVIDER=simulado
SMS_FROM="MULTITEL"
SMS_COUNTRY_CODE="+244"
# Preenchidos apenas quando SMS_PROVIDER=http
SMS_ENDPOINT=
SMS_HTTP_METHOD=POST
# Autenticacao: bearer | basic | header | query | none
SMS_AUTH=bearer
SMS_API_KEY=
SMS_API_SECRET=
SMS_AUTH_HEADER=Authorization
SMS_AUTH_SCHEME=Bearer
SMS_AUTH_QUERY_PARAM=api_key
# Nomes dos campos enviados ao gateway
SMS_CAMPO_DESTINO=to
SMS_CAMPO_MENSAGEM=text
SMS_CAMPO_REMETENTE=from
# Formato do numero: internacional | sem_mais | nacional
SMS_FORMATO_NUMERO=internacional
# Campos fixos adicionais em JSON (ex.: {"sender":"MULTITEL"})
SMS_CAMPOS_EXTRA=
# Campo da resposta que traz o id do envio
SMS_CAMPO_REFERENCIA=id
# Preenchidos apenas quando SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
