/* =========================================================
   ESTAGIÁRIOS — colar no fim do CSS, no lugar do bloco
   "Gestão de estágio: formulário simples e legível"
   (esse bloco redefinia .modal-overlay e usava azul fora da paleta)
   ========================================================= */

.filtros-estagiarios {
  grid-template-columns: minmax(260px, 1.7fr) minmax(190px, 0.8fr) auto;
}

.botao-filtro { height: 40px; min-height: 40px; }

.mensagem-erro.faixa {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.mensagem-erro.faixa .botao-limpar-filtros { height: 32px; flex-shrink: 0; }

.periodo { display: inline-block; line-height: 1.5; }

.info-estagio {
  display: inline-block;
  max-width: 220px;
  font-size: 12px;
  line-height: 1.4;
  color: var(--suave);
}

/* Estado do estágio */
.estado-estagio { text-transform: capitalize; }

.estagio-ativo     { background: #EAF8EF; color: #16703C; }
.estagio-aprovada  { background: #FFF4D6; color: #9A6700; }
.estagio-suspenso  { background: #FFF1E6; color: #B54700; }
.estagio-concluido { background: var(--azul-claro); color: var(--azul); }
.estagio-cancelado { background: #FFF0F1; color: var(--vermelho); }

/* Modal: gerir estágio */
.modal-estreito { width: min(520px, 100%); }

form.modal-body { gap: 16px; }

.campos-duas-colunas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }

.campo-departamento select {
  width: 100%;
  height: 40px;
  padding: 0 12px;
  border: 1px solid #CBD5E1;
  border-radius: 8px;
  background: #fff;
  color: var(--texto);
  font: inherit;
  font-size: 13px;
}

.campo-departamento select:focus {
  outline: none;
  border-color: var(--azul-medio);
  box-shadow: 0 0 0 3px rgba(26, 61, 107, 0.14);
}

.campo-departamento input[readonly] {
  background: var(--azul-claro);
  font-weight: 700;
  color: var(--azul);
}

form.modal-body .acoes-formulario-departamento { margin-top: 4px; }

@media (max-width: 1000px) {
  .filtros-estagiarios { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .filtros-estagiarios .botao-filtro { width: 100%; }
}

@media (max-width: 560px) {
  .filtros-estagiarios { grid-template-columns: 1fr; }
  .campos-duas-colunas { grid-template-columns: 1fr; }
  .mensagem-erro.faixa { flex-direction: column; align-items: flex-start; }
}