
<div class="painel-shell">

  <aside class="barra-lateral">

    <div class="marca-multitel">
      <img src="assets/img/multitel.png" alt="Multitel" class="logo-multitel" />
      <div class="marca-texto">
        <strong>SGE</strong>
        <span>Gestão de Estágios</span>
      </div>
    </div>

    <div class="menu-titulo">MENU PRINCIPAL</div>

    <nav class="menu-lateral" aria-label="Navegação administrativa">

      <button
        type="button"
        class="menu-item"
        [class.ativo]="secaoAtiva() === 'dashboard'"
        (click)="irParaSecao('dashboard')">
        <span class="menu-icone">â–¦</span>
        <span>Dashboard</span>
      </button>

      <button
        type="button"
        class="menu-item"
        [class.ativo]="secaoAtiva() === 'candidaturas'"
        (click)="irParaSecao('candidaturas')">
        <span class="menu-icone">â–¤</span>
        <span>Candidaturas</span>
      </button>

      <div class="menu-item">
        <span class="menu-icone">â™™</span>
        <span>Estagi×¡rios</span>
      </div>

      <div class="menu-item">
        <span class="menu-icone">â–£</span>
        <span>Estágios</span>
      </div>

      <div class="menu-item">
        <span class="menu-icone">â–¥</span>
        <span>Relat×³rios</span>
      </div>

      <div class="menu-item">
        <span class="menu-icone">â˜…</span>
        <span>Avaliações</span>
      </div>

      <div class="menu-item">
        <span class="menu-icone">â—·</span>
        <span>Assiduidade</span>
      </div>

      <!-- NOVA OP×‡×ƒO: DEPARTAMENTOS -->
      <button
        type="button"
        class="menu-item"
        [class.ativo]="secaoAtiva() === 'departamentos'"
        (click)="irParaSecao('departamentos')">
        <span class="menu-icone">âŒ‚</span>
        <span>Departamentos</span>
      </button>

    </nav>

    <div class="menu-separador"></div>

    <div class="menu-titulo">SISTEMA</div>

    <nav class="menu-lateral">
      <div class="menu-item">
        <span class="menu-icone">âš™</span>
        <span>Definições</span>
      </div>
    </nav>

    <div class="sair-container">
      <button type="button" class="botao-sair" (click)="sair()">
        <span class="icone-sair" aria-hidden="true">â†ª</span>
        <span>Sair</span>
      </button>
    </div>

    <div class="perfil-lateral">
      <div class="avatar-admin">A</div>
      <div class="perfil-lateral-info">
        <strong>Administrador</strong>
        <span>Gestão do sistema</span>
      </div>
      <span class="estado-online"></span>
    </div>

  </aside>


  <main class="conteudo-painel">

    <header class="barra-superior">

      <div class="identidade-superior">
        <div class="sigla-sge">SGE</div>
        <div>
          <span class="superior-subtitulo">MULTITEL</span>
          <strong>Sistema de Gestão de Estágios</strong>
        </div>
      </div>

      <div class="superior-direita">
        <span class="estado-sistema">
          <span class="estado-online"></span>
          Sistema operacional
        </span>

        <div class="admin-resumo">
          <div class="avatar-admin pequeno">A</div>
          <div>
            <strong>Administrador</strong>
            <span>Acesso administrativo</span>
          </div>
        </div>
      </div>

    </header>


    <!-- =====================================================
         DASHBOARD E CANDIDATURAS
         ===================================================== -->

    <section id="dashboard" class="painel-admin" [style.display]="secaoAtiva() === 'dashboard' ? 'block' : 'none'">

      <header class="cabecalho">

        <div>
          <span class="subtitulo">SISTEMA DE GEST×ƒO DE ESTAGI×RIOS</span>
          <h1>Painel Administrativo</h1>
          <p>Gestão e acompanhamento das candidaturas de estágio.</p>
        </div>

        <button
          type="button"
          class="botao-atualizar"
          (click)="atualizarPainel()"
          [disabled]="carregandoDashboard() || carregandoCandidaturas() || carregandoDepartamentos()">
          <span class="icone-atualizar" aria-hidden="true">â†»</span>
          Atualizar
        </button>

      </header>

      @if (erroDashboard()) {
        <div class="mensagem-erro" role="alert">
          {{ erroDashboard() }}
        </div>
      }

      <section class="indicadores">

        <article class="indicador indicador-total">
          <div class="indicador-icone">#</div>
          <div class="indicador-conteudo">
            <span class="indicador-label">Total de estagiários</span>
            @if (carregandoDashboard()) {
              <strong class="indicador-valor">...</strong>
            } @else {
              <strong class="indicador-valor">
                {{ dashboard().total_candidaturas }}
              </strong>
            }
          </div>
        </article>

        <article class="indicador indicador-analise">
          <div class="indicador-icone">â—·</div>
          <div class="indicador-conteudo">
            <span class="indicador-label">Em análise</span>
            @if (carregandoDashboard()) {
              <strong class="indicador-valor">...</strong>
            } @else {
              <strong class="indicador-valor">
                {{ dashboard().em_analise }}
              </strong>
            }
          </div>
        </article>

        <article class="indicador indicador-aprovadas">
          <div class="indicador-icone">✓</div>
          <div class="indicador-conteudo">
            <span class="indicador-label">Aprovadas</span>
            @if (carregandoDashboard()) {
              <strong class="indicador-valor">...</strong>
            } @else {
              <strong class="indicador-valor">
                {{ dashboard().aprovadas }}
              </strong>
            }
          </div>
        </article>

        <article class="indicador indicador-recusadas">
          <div class="indicador-icone">×</div>
          <div class="indicador-conteudo">
            <span class="indicador-label">Recusadas</span>
            @if (carregandoDashboard()) {
              <strong class="indicador-valor">...</strong>
            } @else {
              <strong class="indicador-valor">
                {{ dashboard().recusadas }}
              </strong>
            }
          </div>
        </article>

      </section>


      <!-- ===================================================
           LISTA DE CANDIDATURAS
           =================================================== -->

      <section id="candidaturas" class="area-candidaturas" [style.display]="secaoAtiva() === 'candidaturas' ? 'block' : 'none'">

        <div class="cabecalho-secao">
          <div>
            <h2>Candidaturas</h2>
            <p>Consulte, filtre e acompanhe as candidaturas recebidas.</p>
          </div>
          <span class="contador-candidaturas">
            {{ totalCandidaturas() }} candidatura(s)
          </span>
        </div>

        <div class="filtros-candidaturas">

          <div class="filtro-pesquisa">
            <label for="pesquisa">Pesquisar candidaturas</label>
            <div class="campo-pesquisa-profissional">
              <span class="icone-pesquisa" aria-hidden="true">âŒ•</span>
              <input
                id="pesquisa"
                type="search"
                placeholder="Nome, e-mail, curso ou universidade"
                [value]="pesquisa()"
                (input)="pesquisa.set($any($event.target).value)"
                (keyup.enter)="pesquisar()"
                autocomplete="off" />

              @if (pesquisa()) {
                <button
                  type="button"
                  class="botao-limpar-pesquisa"
                  aria-label="Limpar pesquisa"
                  (click)="pesquisa.set(''); pesquisar()">
                  ×
                </button>
              }
            </div>
          </div>

          <div class="filtro-select">
            <label for="estado">Estado</label>
            <select
              id="estado"
              [value]="estadoSelecionado()"
              (change)="alterarEstado($event)">
              <option value="">Todos os estados</option>
              <option value="em_analise">Em análise</option>
              <option value="aprovada">Aprovadas</option>
              <option value="recusada">Recusadas</option>
              <option value="encerrada">Encerradas</option>
            </select>
          </div>

          <div class="filtro-select">
            <label for="departamento">Departamento</label>
            <select
              id="departamento"
              [value]="departamentoSelecionado() ?? ''"
              (change)="alterarDepartamento($event)">
              <option value="">Todos os departamentos</option>
              @for (
                departamento of departamentos();
                track departamento.id_departamento
              ) {
                <option [value]="departamento.id_departamento">
                  {{ departamento.nome }}
                </option>
              }
            </select>
          </div>

          <button
            type="button"
            class="botao-limpar-filtros"
            (click)="limparFiltros()">
            Limpar filtros
          </button>

        </div>

        @if (erroCandidaturas()) {
          <div class="mensagem-erro" role="alert">
            {{ erroCandidaturas() }}
          </div>
        }

        <div class="tabela-wrapper">

          @if (carregandoCandidaturas()) {

            <div class="estado-vazio carregamento">
              <div class="spinner"></div>
              <p>A carregar candidaturas...</p>
            </div>

          } @else if (candidaturas().length === 0) {

            <div class="estado-vazio">
              <div class="estado-vazio-icone">â—Œ</div>
              <h3>Nenhuma candidatura encontrada</h3>
              <p>
                Não existem candidaturas que correspondam aos filtros selecionados.
              </p>
            </div>

          } @else {

            <table class="tabela-candidaturas">

              <thead>
                <tr>
                  <th>Candidato</th>
                  <th>Curso</th>
                  <th>Universidade</th>
                  <th>Departamento</th>
                  <th>Estado</th>
                  <th>Data</th>
                  <th class="coluna-acoes">Ações</th>
                </tr>
              </thead>

              <tbody>
                @for (
                  candidatura of candidaturas();
                  track candidatura.id_candidatura
                ) {
                  <tr>

                    <td>
                      <div class="candidato-info">
                        <div class="avatar-candidato">
                          {{ iniciais(candidatura.nome) }}
                        </div>
                        <div>
                          <strong>{{ candidatura.nome }}</strong>
                          <span>{{ candidatura.email }}</span>
                        </div>
                      </div>
                    </td>

                    <td>
                      <span class="texto-tabela">
                        {{ candidatura.curso || '—' }}
                      </span>
                    </td>

                    <td>
                      <span class="texto-tabela">
                        {{ candidatura.universidade || '—' }}
                      </span>
                    </td>

                    <td>
                      <span class="texto-tabela">
                        {{ candidatura.departamento?.nome || '—' }}
                      </span>
                    </td>

                    <td>
                      <span
                        class="estado-badge"
                        [class]="classeEstado(candidatura.estado)">
                        {{ nomeEstado(candidatura.estado) }}
                      </span>
                    </td>

                    <td>
                      <span class="data-tabela">
                        {{ candidatura.created_at | date:'dd/MM/yyyy' }}
                      </span>
                    </td>

                    <td class="coluna-acoes">
                      <button
                        type="button"
                        class="botao-visualizar"
                        (click)="abrirDetalhes(candidatura.id_candidatura)">
                        <span aria-hidden="true">â—‰</span>
                        Ver
                      </button>
                    </td>

                  </tr>
                }
              </tbody>

            </table>

          }

        </div>

        @if (!carregandoCandidaturas() && candidaturas().length > 0) {

          <div class="paginacao">

            <div class="paginacao-info">
              Página <strong>{{ paginaAtual() }}</strong>
              de <strong>{{ ultimaPagina() }}</strong>
            </div>

            <div class="paginacao-botoes">

              <button
                type="button"
                class="botao-paginacao"
                [disabled]="paginaAtual() <= 1"
                (click)="paginaAnterior()"
                aria-label="Página anterior">
                ‹¹
              </button>

              @for (pagina of paginasVisiveis(); track pagina) {
                <button
                  type="button"
                  class="botao-paginacao"
                  [class.ativo]="pagina === paginaAtual()"
                  (click)="irParaPagina(pagina)">
                  {{ pagina }}
                </button>
              }

              <button
                type="button"
                class="botao-paginacao"
                [disabled]="paginaAtual() >= ultimaPagina()"
                (click)="proximaPagina()"
                aria-label="Página seguinte">
                ‹º
              </button>

            </div>
          </div>
        }

      </section>

    </section>


    <!-- =====================================================
         NOVA SEC×‡×ƒO: DEPARTAMENTOS
         ===================================================== -->

    <section id="departamentos" class="area-departamentos" [style.display]="secaoAtiva() === 'departamentos' ? 'block' : 'none'">

      <header class="cabecalho-secao departamentos-cabecalho">

        <div>
          <span class="subtitulo">ORGANIZA×‡×ƒO DA MULTITEL</span>
          <h2>Gestão de departamentos</h2>
          <p>
            Consulte os departamentos e compare o número de estágios ativos.
          </p>
        </div>

        <button
          type="button"
          class="botao-novo-departamento"
          (click)="novoDepartamento()">
          <span aria-hidden="true">ï¼‹</span>
          Novo departamento
        </button>

      </header>


      @if (sucessoDepartamento()) {
        <div class="mensagem-sucesso" role="status">
          {{ sucessoDepartamento() }}
        </div>
      }


      @if (erroDepartamentos()) {
        <div class="mensagem-erro" role="alert">
          {{ erroDepartamentos() }}
        </div>
      }


      <!-- DESTAQUE DO DEPARTAMENTO COM MAIOR NÚMERO DE EST×GIOS -->

      @if (
        !carregandoDepartamentos() &&
        departamentos().length > 0
      ) {

        <article class="departamento-destaque">

          <div class="departamento-destaque-icone" aria-hidden="true">
            â˜…
          </div>

          <div class="departamento-destaque-conteudo">
            <span>Departamento com mais estagiários ativos</span>
            <strong>{{ departamentos()[0].nome }}</strong>
            <p>
              {{
                departamentos()[0].estagiarios_ativos ?? 0
              }}
              estágio(s) ativo(s)
            </p>
          </div>

        </article>

      }


      <!-- FORMUL×RIO DE CRIAÇ×O OU EDIÇ×O -->

      @if (mostrarFormularioDepartamento()) {

        <section class="formulario-departamento">

          <header class="formulario-departamento-cabecalho">
            <div>
              <h3>
                {{
                  departamentoEmEdicao()
                    ? 'Editar departamento'
                    : 'Novo departamento'
                }}
              </h3>
              <p>
                Preencha os campos abaixo.
              </p>
            </div>

            <button
              type="button"
              class="botao-fechar-formulario"
              aria-label="Fechar formulário"
              (click)="cancelarFormularioDepartamento()">
              ×
            </button>
          </header>


          @if (erroFormularioDepartamento()) {
            <div class="mensagem-erro" role="alert">
              {{ erroFormularioDepartamento() }}
            </div>
          }


          <div class="campos-formulario-departamento">

            <div class="campo-departamento">
              <label for="nomeDepartamento">
                Nome do departamento *
              </label>
              <input
                id="nomeDepartamento"
                type="text"
                maxlength="255"
                placeholder="Ex.: Tecnologias de Informação"
                [value]="nomeDepartamento()"
                (input)="alterarNomeDepartamento($event)"
                autocomplete="off" />
            </div>

            <div class="campo-departamento">
              <label for="descricaoDepartamento">
                Descrição
              </label>
              <textarea
                id="descricaoDepartamento"
                rows="4"
                placeholder="Descreva as responsabilidades deste departamento."
                [value]="descricaoDepartamento()"
                (input)="alterarDescricaoDepartamento($event)"></textarea>
            </div>

          </div>


          <footer class="acoes-formulario-departamento">

            <button
              type="button"
              class="botao-cancelar-departamento"
              (click)="cancelarFormularioDepartamento()"
              [disabled]="guardandoDepartamento()">
              Cancelar
            </button>

            <button
              type="button"
              class="botao-guardar-departamento"
              (click)="guardarDepartamento()"
              [disabled]="guardandoDepartamento()">

              @if (guardandoDepartamento()) {
                A guardar...
              } @else {
                {{ departamentoEmEdicao() ? 'Guardar alterações' : 'Criar departamento' }}
              }

            </button>

          </footer>

        </section>

      }


      <!-- LISTA DE DEPARTAMENTOS -->

      @if (carregandoDepartamentos()) {

        <div class="estado-vazio carregamento">
          <div class="spinner"></div>
          <p>A carregar departamentos...</p>
        </div>

      } @else if (departamentos().length === 0) {

        <div class="estado-vazio">
          <div class="estado-vazio-icone">â—Œ</div>
          <h3>Nenhum departamento dispon×­vel</h3>
          <p>
            Não foi poss×­vel encontrar departamentos ativos.
            Podes criar um novo departamento.
          </p>
        </div>

      } @else {

        <div class="lista-departamentos">

          @for (
            departamento of departamentos();
            track departamento.id_departamento
          ) {

            <article class="cartao-departamento">

              <div class="cartao-departamento-topo">

                <div class="cartao-departamento-icone" aria-hidden="true">
                  âŒ‚
                </div>

                <span class="departamento-estado">
                  {{ departamento.ativo === false ? 'Inativo' : 'Ativo' }}
                </span>

              </div>


              <div class="cartao-departamento-conteudo">

                <h3>{{ departamento.nome }}</h3>

                <p>
                  {{
                    departamento.descricao ||
                    'Sem descri×§×£o registada.'
                  }}
                </p>

              </div>


              <div class="cartao-departamento-estatistica">

                <span>Estagi×¡rios com estágio ativo</span>

                <strong>
                  {{ departamento.estagiarios_ativos ?? 0 }}
                </strong>

              </div>


              <footer class="cartao-departamento-acoes">

                <button
                  type="button"
                  class="botao-editar-departamento"
                  (click)="editarDepartamento(departamento)">
                  <span aria-hidden="true">✓Ž</span>
                  Editar departamento
                </button>

              </footer>

            </article>

          }

        </div>

      }

      <p class="nota-departamentos">
        Os números representam estágios com estado ativo registados na base de dados.
      </p>

    </section>


    <!-- =====================================================
         MODAL DE DETALHES DA CANDIDATURA
         ===================================================== -->

    @if (candidaturaSelecionada() || carregandoDetalhes()) {

      <div
        class="modal-overlay modal-detalhes"
        role="dialog"
        aria-modal="true"
        aria-label="Detalhes da candidatura">

        <div class="modal-caixa">

          <header class="modal-header">
            <div>
              <span class="modal-subtitulo">CANDIDATURA</span>
              <h2>Detalhes da candidatura</h2>
            </div>

            <button
              type="button"
              class="botao-fechar"
              (click)="fecharDetalhes()"
              aria-label="Fechar detalhes">
              ×
            </button>
          </header>


          @if (carregandoDetalhes()) {

            <div class="modal-carregando">
              <div class="spinner"></div>
              <p>A carregar dados da candidatura...</p>
            </div>

          } @else if (erroDetalhes()) {

            <div class="mensagem-erro modal-mensagem" role="alert">
              {{ erroDetalhes() }}
            </div>

          } @else if (candidaturaSelecionada()) {

            <div class="modal-body">

              <section class="detalhes-cabecalho">
                <div class="avatar-candidato grande">
                  {{ iniciais(candidaturaSelecionada()!.nome) }}
                </div>

                <div class="detalhes-cabecalho-info">
                  <h3>{{ candidaturaSelecionada()!.nome }}</h3>
                  <span>{{ candidaturaSelecionada()!.email }}</span>
                  <span
                    class="estado-badge"
                    [class]="classeEstado(candidaturaSelecionada()!.estado)">
                    {{ nomeEstado(candidaturaSelecionada()!.estado) }}
                  </span>
                </div>
              </section>


              <section class="detalhes-secao">

                <div class="titulo-detalhes-secao">
                  <span class="titulo-icone">◆</span>
                  <h3>Dados pessoais</h3>
                </div>

                <div class="detalhes-grid">

                  <div class="detalhe-card">
                    <span>Nome completo</span>
                    <strong>{{ candidaturaSelecionada()!.nome }}</strong>
                  </div>

                  <div class="detalhe-card">
                    <span>E-mail</span>
                    <strong>{{ candidaturaSelecionada()!.email }}</strong>
                  </div>

                  <div class="detalhe-card">
                    <span>Contacto</span>
                    <strong>{{ candidaturaSelecionada()!.contacto || '—' }}</strong>
                  </div>

                  <div class="detalhe-card">
                    <span>Bilhete de identidade</span>
                    <strong>{{ candidaturaSelecionada()!.bi || '—' }}</strong>
                  </div>

                  <div class="detalhe-card">
                    <span>Data de nascimento</span>
                    <strong>
                      {{ candidaturaSelecionada()!.nascimento | date:'dd/MM/yyyy' }}
                    </strong>
                  </div>

                  <div class="detalhe-card">
                    <span>Sexo</span>
                    <strong>{{ candidaturaSelecionada()!.sexo || '—' }}</strong>
                  </div>

                </div>

              </section>


              <section class="detalhes-secao">

                <div class="titulo-detalhes-secao">
                  <span class="titulo-icone">◉</span>
                  <h3>Dados académicos</h3>
                </div>

                <div class="detalhes-grid">

                  <div class="detalhe-card">
                    <span>Curso</span>
                    <strong>{{ candidaturaSelecionada()!.curso || '—' }}</strong>
                  </div>

                  <div class="detalhe-card">
                    <span>Universidade</span>
                    <strong>{{ candidaturaSelecionada()!.universidade || '—' }}</strong>
                  </div>

                  <div class="detalhe-card">
                    <span>Departamento selecionado</span>
                    <strong>
                      {{ candidaturaSelecionada()!.departamento?.nome || '—' }}
                    </strong>
                  </div>

                  <div class="detalhe-card">
                    <span>Data da candidatura</span>
                    <strong>
                      {{ candidaturaSelecionada()!.created_at | date:'dd/MM/yyyy HH:mm' }}
                    </strong>
                  </div>

                </div>

              </section>


              @if (candidaturaSelecionada()!.estado === 'recusada') {

                <section class="detalhes-secao">
                  <div class="titulo-detalhes-secao">
                    <span class="titulo-icone">!</span>
                    <h3>Motivo da recusa</h3>
                  </div>

                  <div class="motivo-recusa-existente">
                    {{
                      candidaturaSelecionada()!.motivo_recusa ||
                      'Nenhum motivo informado.'
                    }}
                  </div>
                </section>

              }


              <section class="detalhes-secao documentos-secao">

                <div class="titulo-detalhes-secao">
                  <span class="titulo-icone">▣</span>
                  <div>
                    <h3>Documentos</h3>
                    <p>Documentos enviados pelo candidato.</p>
                  </div>
                </div>


                @if (
                  candidaturaSelecionada()!.documentos &&
                  candidaturaSelecionada()!.documentos!.length > 0
                ) {

                  <div class="lista-documentos">

                    @for (
                      documento of candidaturaSelecionada()!.documentos!;
                      track documento.id_documento
                    ) {

                      <div class="documento-item">
                        <div class="documento-icone">▣</div>

                        <div class="documento-info">
                          <strong>{{ documento.nome_arquivo }}</strong>
                          <span>{{ documento.tipo_documento }}</span>
                        </div>

                        <button
                          type="button"
                          class="botao-documento"
                          (click)="visualizarDocumento(documento)"
                          [disabled]="abrindoDocumento()">
                          {{ abrindoDocumento() ? 'A abrir...' : 'Ver documento' }}
                        </button>
                      </div>

                    }

                  </div>

                } @else {

                  <div class="documentos-vazios">
                    <span>Nenhum documento encontrado.</span>
                  </div>

                }


                @if (erroDocumento()) {
                  <div class="mensagem-erro" role="alert">
                    {{ erroDocumento() }}
                  </div>
                }

              </section>


              @if (sucessoDecisao()) {
                <div class="mensagem-sucesso" role="status">
                  {{ sucessoDecisao() }}
                </div>
              }

              @if (erroDecisao()) {
                <div class="mensagem-erro" role="alert">
                  {{ erroDecisao() }}
                </div>
              }


              @if (candidaturaSelecionada()!.estado === 'em_analise') {

                @if (mostrarRecusa()) {

                  <section class="area-recusa">

                    <div>
                      <h3>Recusar candidatura</h3>
                      <p>Informe o motivo da recusa.</p>
                    </div>

                    <textarea
                      rows="4"
                      maxlength="1000"
                      [value]="motivoRecusa()"
                      (input)="alterarMotivoRecusa($event)"
                      placeholder="Digite o motivo da recusa...">
                    </textarea>

                    <div class="contador-caracteres">
                      {{ motivoRecusa().length }}/1000
                    </div>

                    <div class="acoes-recusa">

                      <button
                        type="button"
                        class="botao-fechar-recusa"
                        (click)="cancelarRecusa()"
                        [disabled]="processandoDecisao()">
                        Cancelar
                      </button>

                      <button
                        type="button"
                        class="botao-confirmar-recusa"
                        (click)="recusarSelecionada()"
                        [disabled]="processandoDecisao()">
                        {{ processandoDecisao() ? 'A processar...' : 'Confirmar recusa' }}
                      </button>

                    </div>

                  </section>

                } @else {

                  <div class="acoes-candidatura">

                    <button
                      type="button"
                      class="botao-recusar"
                      (click)="abrirRecusa()"
                      [disabled]="processandoDecisao()">
                      <span aria-hidden="true">×</span>
                      Recusar
                    </button>

                    <button
                      type="button"
                      class="botao-aprovar"
                      (click)="aprovarSelecionada()"
                      [disabled]="processandoDecisao()">
                      <span aria-hidden="true">✓</span>
                      {{ processandoDecisao() ? 'A processar...' : 'Aprovar candidatura' }}
                    </button>

                  </div>

                }

              }

            </div>

          }

        </div>

      </div>

    }


    <!-- =====================================================
         MODAL DE VISUALIZAÇÃO DE DOCUMENTO
         ===================================================== -->

    @if (documentoPreviewAberto()) {

      <div
        class="modal-overlay modal-documento-preview"
        role="dialog"
        aria-modal="true"
        aria-label="Visualização do documento">

        <div class="modal-documento-caixa">

          <header class="modal-documento-header">
            <div>
              <span class="modal-subtitulo">DOCUMENTO</span>
              <h2>{{ documentoPreviewNome() }}</h2>
            </div>

            <button
              type="button"
              class="botao-fechar-documento"
              (click)="fecharPreviewDocumento()"
              aria-label="Fechar visualização">
              ×
            </button>
          </header>


          <div class="documento-preview-body">

            @if (documentoPreviewTipo().startsWith('image/')) {

              <div class="imagem-preview-container">
                <img
                  [src]="documentoPreviewUrl()"
                  [alt]="documentoPreviewNome()"
                  class="imagem-documento-preview" />
              </div>

            } @else if (documentoPreviewTipo() === 'application/pdf') {

              <iframe
                class="pdf-documento-preview"
                [src]="documentoPreviewPdfUrl()"
                [title]="documentoPreviewNome()">
              </iframe>

            } @else {

              <div class="documento-tipo-nao-suportado">
                <div class="documento-tipo-icone">▣</div>
                <h3>Pré-visualização não dispon×­vel</h3>
                <p>
                  Este tipo de documento não pode ser visualizado diretamente no navegador.
                </p>

                <a
                  class="botao-download-documento"
                  [href]="documentoPreviewUrl()"
                  [download]="documentoPreviewNome()">
                  Baixar documento
                </a>
              </div>

            }

          </div>


          <footer class="modal-documento-footer">
            <button
              type="button"
              class="botao-fechar-documento-footer"
              (click)="fecharPreviewDocumento()">
              Fechar
            </button>
          </footer>

        </div>

      </div>

    }

  </main>


  <footer class="rodape-painel">
    <span>© 2026 Multitel</span>
    <span>SGE — Sistema de Gestão de Estágios</span>
  </footer>

</div>


