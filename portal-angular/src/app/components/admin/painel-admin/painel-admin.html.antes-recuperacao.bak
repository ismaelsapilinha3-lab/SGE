<!-- =====================================================
         ESTAGIÁRIOS
         ===================================================== -->
    <section id="estagiarios" class="area-candidaturas" [style.display]="secaoAtiva() === 'estagiarios' ? 'block' : 'none'">

      <header class="cabecalho-secao">
        <div>
          <h2>Estagiários</h2>
          <p>Consulte os estagiários registados e gira o estado de cada estágio.</p>
        </div>

        <button type="button" class="botao-novo-departamento" (click)="carregarEstagiarios()">
          <span aria-hidden="true">↻</span>
          Atualizar
        </button>
      </header>

      <form class="filtros-candidaturas filtros-estagiarios" (submit)="$event.preventDefault(); pesquisarEstagiarios()">

        <div class="filtro-pesquisa">
          <label for="pesquisaEstagiarios">Pesquisar estagiários</label>
          <div class="campo-pesquisa-profissional">
            <span class="icone-pesquisa" aria-hidden="true">⌕</span>
            <input
              id="pesquisaEstagiarios"
              type="search"
              placeholder="Nome ou e-mail"
              [value]="pesquisaEstagiarios()"
              (input)="pesquisaEstagiarios.set($any($event.target).value)"
              autocomplete="off" />
          </div>
        </div>

        <div class="filtro-select">
          <label for="estadoEstagiarios">Estado</label>
          <select
            id="estadoEstagiarios"
            [value]="estadoEstagiarios()"
            (change)="estadoEstagiarios.set($any($event.target).value); carregarEstagiarios()">
            <option value="">Todos os estados</option>
            <option value="aprovada">Aprovada, a aguardar início</option>
            <option value="ativo">Ativo</option>
            <option value="concluido">Concluído</option>
            <option value="suspenso">Suspenso</option>
            <option value="cancelado">Cancelado</option>
          </select>
        </div>

        <button type="submit" class="botao-visualizar botao-filtro">Pesquisar</button>

      </form>

      @if (erroEstagiarios()) {
        <div class="mensagem-erro faixa" role="alert">
          {{ erroEstagiarios() }}
          <button type="button" class="botao-limpar-filtros" (click)="carregarEstagiarios()">Tentar novamente</button>
        </div>
      }

      <div class="tabela-wrapper">

        @if (carregandoEstagiarios()) {

          <div class="estado-vazio">
            <div class="spinner"></div>
            <p>A carregar estagiários...</p>
          </div>

        } @else if (!erroEstagiarios() && estagiarios().length === 0) {

          <div class="estado-vazio">
            <div class="estado-vazio-icone" aria-hidden="true">∅</div>
            <h3>Nenhum estagiário encontrado</h3>
            <p>Não existem estagiários que correspondam aos filtros selecionados.</p>
          </div>

        } @else if (estagiarios().length > 0) {

          <table class="tabela-candidaturas">
            <thead>
              <tr>
                <th scope="col">Estagiário</th>
                <th scope="col">Curso</th>
                <th scope="col">Universidade</th>
                <th scope="col">Departamento</th>
                <th scope="col">Período</th>
                <th scope="col">Estado</th>
                <th scope="col">Informação</th>
                <th scope="col" class="coluna-acoes">Ações</th>
              </tr>
            </thead>

            <tbody>
              @for (estagiario of estagiarios(); track estagiario.id_estagio ?? estagiario.id_candidatura) {
                <tr>
                  <td>
                    <div class="candidato-info">
                      <div class="avatar-candidato">{{ iniciais(estagiario.nome) }}</div>
                      <div>
                        <strong>{{ estagiario.nome }}</strong>
                        <span>{{ estagiario.email }}</span>
                        @if (estagiario.telefone) {
                          <span>{{ estagiario.telefone }}</span>
                        }
                      </div>
                    </div>
                  </td>
                  <td><span class="texto-tabela">{{ estagiario.curso || '—' }}</span></td>
                  <td><span class="texto-tabela">{{ estagiario.universidade || '—' }}</span></td>
                  <td><span class="texto-tabela">{{ estagiario.departamento || '—' }}</span></td>
                  <td>
                    <span class="data-tabela periodo">
                      {{ (estagiario.data_inicio | date:'dd/MM/yyyy') || '—' }}
                      a
                      {{ (estagiario.data_fim_prevista | date:'dd/MM/yyyy') || '—' }}
                    </span>
                  </td>
                  <td>
                    <span class="estado-badge estado-estagio" [class]="'estado-badge estado-estagio estagio-' + estagiario.estado_estagio">
                      {{ estagiario.estado_estagio === 'aprovada' ? 'Aguarda início' : (estagiario.estado_estagio || '—') }}
                    </span>
                  </td>
                  <td>
                    <span class="info-estagio">
                      @if (estagiario.estado_estagio === 'ativo') {
                        @if (diasRestantes(estagiario) === null) {
                          Data de término não definida
                        } @else if (diasRestantes(estagiario)! <= 0) {
                          Prazo terminado
                        } @else {
                          {{ diasRestantes(estagiario) }} dias restantes
                        }
                      } @else if (estagiario.estado_estagio === 'suspenso') {
                        Motivo: {{ estagiario.motivo_suspensao || 'não registado' }}
                      } @else if (estagiario.estado_estagio === 'aprovada') {
                        A aguardar início do estágio
                      } @else if (estagiario.estado_estagio === 'concluido') {
                        Estágio concluído
                      } @else if (estagiario.estado_estagio === 'cancelado') {
                        Estágio cancelado
                      } @else {
                        —
                      }
                    </span>
                  </td>
                  <td class="coluna-acoes">
                    <button type="button" class="botao-visualizar" (click)="abrirGestaoEstagio(estagiario)">
                      Gerir estágio
                    </button>
                  </td>
                </tr>
              }
            </tbody>
          </table>

        }

      </div>

    </section>


    <!-- =====================================================
         MODAL: GERIR ESTÁGIO
         ===================================================== -->
    @if (estagioEmGestao(); as estagioSelecionado) {

      <div class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="titulo-gestao-estagio">
        <div class="modal-caixa modal-estreito">

          <header class="modal-header">
            <div>
              <span class="modal-subtitulo">{{ estagioSelecionado.nome }}</span>
              <h2 id="titulo-gestao-estagio">Gerir estágio</h2>
            </div>

            <button type="button" class="botao-fechar" (click)="fecharGestaoEstagio()" aria-label="Fechar">
              ×
            </button>
          </header>

          <form class="modal-body" (submit)="$event.preventDefault(); guardarEstadoEstagio()">

            <div class="campo-departamento">
              <label for="estado-estagio">Estado</label>
              <select
                id="estado-estagio"
                required
                [value]="estadoEstagioFormulario()"
                (change)="estadoEstagioFormulario.set($any($event.target).value)">
                <option value="ativo">Ativo</option>
                <option value="suspenso">Suspenso</option>
                <option value="concluido">Concluído</option>
                <option value="cancelado">Cancelado</option>
              </select>
            </div>

            <div class="campos-duas-colunas">
              <div class="campo-departamento">
                <label for="data-inicio-estagio">Data de início</label>
                <input
                  id="data-inicio-estagio"
                  type="date"
                  required
                  [value]="inicioEstagioFormulario()"
                  (input)="inicioEstagioFormulario.set($any($event.target).value)" />
              </div>

              <div class="campo-departamento">
                <label for="duracao-estagio-meses">Duração (meses)</label>
                <input
                  id="duracao-estagio-meses"
                  type="number"
                  min="1"
                  max="60"
                  required
                  [value]="duracaoMesesFormulario()"
                  (input)="duracaoMesesFormulario.set(+$any($event.target).value)" />
              </div>
            </div>

            <div class="campo-departamento">
              <label for="data-fim-estagio-calculada">Data prevista de término</label>
              <input
                id="data-fim-estagio-calculada"
                type="date"
                readonly
                [value]="calcularDataFimEstagio(inicioEstagioFormulario(), duracaoMesesFormulario())" />
            </div>

            @if (estadoEstagioFormulario() === 'suspenso') {
              <div class="campo-departamento">
                <label for="motivo-suspensao">Motivo da suspensão</label>
                <textarea
                  id="motivo-suspensao"
                  rows="3"
                  required
                  [value]="motivoSuspensaoFormulario()"
                  (input)="motivoSuspensaoFormulario.set($any($event.target).value)"></textarea>
              </div>
            }

            @if (erroGestaoEstagio()) {
              <div class="mensagem-erro" role="alert">{{ erroGestaoEstagio() }}</div>
            }

            <div class="acoes-formulario-departamento">
              <button
                type="button"
                class="botao-cancelar-departamento"
                (click)="fecharGestaoEstagio()"
                [disabled]="aGuardarEstadoEstagio()">
                Cancelar
              </button>

              <button type="submit" class="botao-guardar-departamento" [disabled]="aGuardarEstadoEstagio()">
                {{ aGuardarEstadoEstagio() ? 'A guardar...' : 'Guardar estado' }}
              </button>
            </div>

          </form>

        </div>
      </div>

    }