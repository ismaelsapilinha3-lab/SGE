<div class="area-reservada">
  <header class="cabecalho">
    <div>
      <p class="subtitulo">PORTAL DE ESTÁGIOS  MULTITEL</p>
      <h1>Área reservada do estagiário</h1>
      <p>Acompanha as tuas actividades e informações do estágio.</p>
    </div>

    <button
      type="button"
      class="botao-sair"
      [disabled]="terminandoSessao()"
      (click)="terminarSessao()">
      {{ terminandoSessao() ? 'A terminar sessão...' : 'Terminar sessão' }}
    </button>
  </header>

  <main>
    <section class="cartao-boas-vindas">
      <h2>Bem-vindo à tua área de estágio</h2>
      <p>
        Aqui poderás consultar as informações do teu estágio,
        acompanhar as actividades e aceder aos documentos disponíveis.
      </p>
    </section>

    @if (carregando()) {
      <p class="aviso" role="status">A carregar os dados do estágio...</p>
    } @else if (erro()) {
      <p class="aviso" role="alert">{{ erro() }}</p>
    } @else if (estagio(); as dados) {
      <section class="cartoes">
        <article class="cartao">
          <h3>O meu estágio</h3>
          <p><strong>Estado:</strong> {{ dados.estado_estagio }}</p>
          <p><strong>Data de início:</strong> {{ dados.data_inicio || 'Não definida' }}</p>
          <p><strong>Fim previsto:</strong> {{ dados.data_fim_prevista || 'Não definido' }}</p>
          <p><strong>Referência:</strong> {{ dados.id_estagio }}</p>
        </article>

        <article class="cartao">
          <h3>Actividades</h3>
          <p>O acompanhamento das actividades será apresentado nesta área.</p>
        </article>

        <article class="cartao">
          <h3>Documentos</h3>
          <p>Os documentos do estágio serão apresentados nesta área.</p>
        </article>
      </section>
    }

    <p class="aviso">
      As informações do estágio são consultadas através do Laravel.
    </p>
  </main>
</div>