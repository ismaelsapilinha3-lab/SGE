:host {
  display: block;
  min-height: 100%;
  color: #1b2939;
  background: #f4f7fb;

  --azul: #0a2540;
  --azul-medio: #174a7e;
  --azul-claro: #edf4fc;
  --laranja: #ff6b00;
  --fundo: #f4f7fb;
  --borda: #e1e8f0;
  --texto: #1b2939;
  --texto-suave: #64748b;
  --branco: #ffffff;
  --sombra: 0 8px 24px rgba(10, 37, 64, 0.07);
}

* {
  box-sizing: border-box;
}

button,
a,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  cursor: pointer;
}

.est-topbar {
  width: 100%;
  background: var(--branco);
  border-bottom: 1px solid var(--borda);
}

.est-navbar {
  width: min(1240px, 100%);
  min-height: 76px;
  margin: 0 auto;
  padding: 14px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.est-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--azul);
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -0.4px;
}

.est-brand img {
  display: block;
  width: auto;
  max-width: 150px;
  max-height: 48px;
  object-fit: contain;
}

.est-navlinks {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex-wrap: wrap;
}

.est-navlinks a,
.est-navlinks button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 9px 13px;
  color: #475569;
  background: transparent;
  border: 0;
  border-radius: 9px;
  font-size: 14px;
  font-weight: 600;
  transition: background 0.2s ease, color 0.2s ease;
}

.est-navlinks a:hover,
.est-navlinks button:hover {
  color: var(--azul);
  background: var(--azul-claro);
}

.est-user {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--azul);
  font-size: 14px;
  font-weight: 700;
}

.est-user img {
  width: 42px;
  height: 42px;
  object-fit: cover;
  border: 2px solid #e5edf6;
  border-radius: 50%;
}

.est-logout {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 10px 15px;
  color: #a12c2c;
  background: #fff4f2;
  border: 1px solid #ffded8;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 700;
  transition: background 0.2s ease, transform 0.2s ease;
}

.est-logout:hover {
  background: #ffe8e3;
  transform: translateY(-1px);
}

.est-hero {
  position: relative;
  overflow: hidden;
  padding: 64px 24px 82px;
  color: var(--branco);
  background:
    radial-gradient(circle at 90% 10%, rgba(255, 107, 0, 0.18), transparent 28%),
    linear-gradient(125deg, #091f36 0%, #174a7e 65%, #286393 100%);
}

.est-hero::after {
  position: absolute;
  right: -90px;
  bottom: -170px;
  width: 360px;
  height: 360px;
  content: "";
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  pointer-events: none;
}

.est-hero > * {
  position: relative;
  z-index: 1;
}

.est-hero h1 {
  max-width: 760px;
  margin: 0 0 16px;
  color: var(--branco);
  font-size: clamp(30px, 4vw, 44px);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.8px;
}

.est-hero p {
  max-width: 680px;
  margin: 0;
  color: rgba(255, 255, 255, 0.85);
  font-size: 16px;
  line-height: 1.8;
}

.est-hero .est-btn-primary {
  margin-top: 24px;
}

.est-main {
  position: relative;
  z-index: 2;
  width: min(1240px, 100%);
  margin: -38px auto 0;
  padding: 0 24px 60px;
}

.est-status {
  padding: 28px;
  background: var(--branco);
  border: 1px solid #e5ebf2;
  border-top: 4px solid var(--laranja);
  border-radius: 16px;
  box-shadow: 0 12px 32px rgba(10, 37, 64, 0.09);
}

.est-status h2,
.est-status h3 {
  margin-top: 0;
  color: var(--azul);
}

.est-status p {
  color: var(--texto-suave);
  line-height: 1.7;
}

.est-progress {
  width: 100%;
  height: 9px;
  overflow: hidden;
  margin: 16px 0;
  background: #e8eef5;
  border-radius: 99px;
}

.est-progress > * {
  height: 100%;
  background: linear-gradient(90deg, var(--laranja), #ff9a45);
  border-radius: inherit;
}

.est-section {
  margin-top: 38px;
}

.est-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
  padding-bottom: 14px;
  border-bottom: 1px solid #dce5ef;
}

.est-section-head h2 {
  margin: 0;
  color: var(--azul);
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -0.35px;
}

.est-section-head p {
  margin: 6px 0 0;
  color: var(--texto-suave);
  font-size: 14px;
  line-height: 1.6;
}

.est-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.est-card,
.est-doc,
.est-note,
.est-info {
  min-width: 0;
  padding: 24px;
  background: var(--branco);
  border: 1px solid var(--borda);
  border-radius: 14px;
  box-shadow: var(--sombra);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.est-card:hover,
.est-doc:hover,
.est-note:hover,
.est-info:hover {
  transform: translateY(-2px);
  border-color: #cbd9e8;
  box-shadow: 0 12px 28px rgba(10, 37, 64, 0.1);
}

.est-card h3,
.est-doc h3,
.est-note h3,
.est-info h3 {
  margin: 0 0 10px;
  color: var(--azul);
  font-size: 17px;
  font-weight: 750;
  line-height: 1.45;
}

.est-card p,
.est-doc p,
.est-note p,
.est-info p {
  margin: 0 0 14px;
  color: var(--texto-suave);
  font-size: 14px;
  line-height: 1.75;
  overflow-wrap: anywhere;
}

.est-card-icon,
.est-doc-icon,
.est-bloqueio svg {
  display: none !important;
}

.est-data {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.est-data > div {
  min-width: 0;
  padding: 16px;
  background: #f8fafd;
  border: 1px solid #e8eef5;
  border-radius: 10px;
}

.est-data strong,
.est-data b {
  display: block;
  margin-bottom: 6px;
  color: var(--azul);
  font-size: 13px;
}

.est-data span,
.est-data p {
  color: #526276;
  font-size: 14px;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.est-docs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.est-doc {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12px;
}

.est-doc-prev {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 110px;
  padding: 18px;
  color: var(--azul-medio);
  text-align: center;
  background: linear-gradient(145deg, #edf4fc, #f8faff);
  border: 1px solid #e2eaf4;
  border-radius: 10px;
}

.est-doc-open,
.est-doc-ver {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 10px 15px;
  color: var(--azul-medio);
  background: #edf4fc;
  border: 1px solid #d7e5f5;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
  transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

.est-doc-open:hover,
.est-doc-ver:hover {
  color: var(--azul);
  background: #dceafb;
  transform: translateY(-1px);
}

.est-btn-primary,
.est-btn-light {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 12px 19px;
  border: 1px solid transparent;
  border-radius: 9px;
  font-size: 14px;
  font-weight: 750;
  text-align: center;
  text-decoration: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.est-btn-primary {
  color: var(--branco);
  background: var(--laranja);
  border-color: var(--laranja);
  box-shadow: 0 5px 14px rgba(255, 107, 0, 0.18);
}

.est-btn-primary:hover {
  background: #e85f00;
  box-shadow: 0 8px 18px rgba(255, 107, 0, 0.24);
  transform: translateY(-1px);
}

.est-btn-light {
  color: var(--azul);
  background: var(--branco);
  border-color: #d5e0ec;
}

.est-btn-light:hover {
  background: #f0f5fb;
  transform: translateY(-1px);
}

.est-hist {
  padding: 8px 24px;
  background: var(--branco);
  border: 1px solid var(--borda);
  border-radius: 14px;
  box-shadow: var(--sombra);
}

.est-hist ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.est-hist li {
  position: relative;
  padding: 18px 0 18px 24px;
  color: #526276;
  border-bottom: 1px solid #edf1f6;
  font-size: 14px;
  line-height: 1.7;
}

.est-hist li:last-child {
  border-bottom: 0;
}

.est-hist li::before {
  position: absolute;
  top: 25px;
  left: 0;
  width: 9px;
  height: 9px;
  content: "";
  background: var(--laranja);
  border-radius: 50%;
}

.est-footer {
  padding: 28px 24px;
  color: #cbd5e1;
  background: #091f36;
  text-align: center;
  font-size: 13px;
  line-height: 1.8;
}

.est-footer p {
  margin: 0;
}

.est-footer a {
  color: var(--branco);
  text-decoration: none;
}

.est-footer a:hover {
  color: #ffb37d;
}

.est-bloqueio {
  padding: 18px;
  color: #80520b;
  background: #fff8e8;
  border: 1px solid #f3dfae;
  border-radius: 10px;
  font-size: 14px;
  line-height: 1.7;
}

.est-success {
  color: #176344;
  background: #ecfdf5;
  border-color: #b9efd4;
}

.est-warning {
  color: #80520b;
  background: #fff8e8;
  border-color: #f3dfae;
}

.est-error {
  color: #9f2929;
  background: #fff1f1;
  border-color: #f6cccc;
}

.est-muted {
  color: var(--texto-suave);
}

.est-status a,
.est-section a {
  text-decoration: none;
}

:host button:focus-visible,
:host a:focus-visible,
:host input:focus-visible,
:host select:focus-visible,
:host textarea:focus-visible {
  outline: 3px solid rgba(255, 107, 0, 0.75);
  outline-offset: 3px;
}

@media (max-width: 900px) {
  .est-navbar {
    flex-wrap: wrap;
    justify-content: center;
  }

  .est-brand {
    margin-right: auto;
  }

  .est-navlinks {
    order: 3;
    width: 100%;
  }

  .est-user {
    margin-left: auto;
  }

  .est-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 650px) {
  .est-navbar {
    min-height: 64px;
    padding: 12px 16px;
    gap: 12px;
  }

  .est-brand {
    font-size: 16px;
  }

  .est-brand img {
    max-width: 120px;
    max-height: 40px;
  }

  .est-user {
    gap: 8px;
    font-size: 12px;
  }

  .est-user img {
    width: 36px;
    height: 36px;
  }

  .est-navlinks {
    justify-content: flex-start;
    gap: 4px;
  }

  .est-navlinks a,
  .est-navlinks button {
    min-height: 38px;
    padding: 8px 10px;
    font-size: 12px;
  }

  .est-hero {
    padding: 38px 20px 58px;
  }

  .est-hero h1 {
    font-size: clamp(27px, 7vw, 36px);
  }

  .est-hero p {
    font-size: 14px;
  }

  .est-main {
    margin-top: -24px;
    padding: 0 14px 40px;
  }

  .est-status {
    padding: 20px;
  }

  .est-section {
    margin-top: 30px;
  }

  .est-section-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .est-section-head h2 {
    font-size: 19px;
  }

  .est-grid,
  .est-docs,
  .est-data {
    grid-template-columns: 1fr;
  }

  .est-card,
  .est-doc,
  .est-note,
  .est-info {
    padding: 18px;
  }

  .est-hist {
    padding: 6px 18px;
  }

  .est-btn-primary,
  .est-btn-light {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
    animation: none !important;
  }
}

/* =====================================================
   CORREÇÃO DE ESTILOS  PAINEL DO ESTAGIÁRIO
   ===================================================== */

#pagina-estagiario {
  min-height: 100vh;
  color: #1b2939;
  background: #f4f7fb;
  font-family: Arial, Helvetica, sans-serif;
}

#pagina-estagiario .skip-link {
  position: absolute;
  top: -100px;
  left: 16px;
  z-index: 1000;
  padding: 12px 18px;
  color: #fff;
  background: #0a2540;
  border-radius: 8px;
}

#pagina-estagiario .skip-link:focus {
  top: 12px;
}

#pagina-estagiario .topo {
  padding: 10px 24px;
  color: #fff;
  background: #091f36;
  font-size: 12px;
}

#pagina-estagiario .topo-conteudo,
#pagina-estagiario .barra-conteudo,
#pagina-estagiario .rodape-in {
  width: min(1240px, 100%);
  margin: 0 auto;
}

#pagina-estagiario .topo-conteudo {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

#pagina-estagiario .topo-direita {
  color: #dbe5f0;
}

#pagina-estagiario .cabecalho-principal {
  position: relative;
  z-index: 5;
  background: #fff;
  border-bottom: 1px solid #e1e8f0;
}

#pagina-estagiario .barra {
  padding: 0 24px;
}

#pagina-estagiario .barra-conteudo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  min-height: 82px;
}

#pagina-estagiario .marca {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: #0a2540;
  text-decoration: none;
}

#pagina-estagiario .marca img {
  display: block;
  width: auto;
  max-width: 125px;
  max-height: 48px;
  object-fit: contain;
}

#pagina-estagiario .marca-texto {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

#pagina-estagiario .marca-texto strong {
  font-size: 17px;
  letter-spacing: .5px;
}

#pagina-estagiario .marca-texto small {
  color: #64748b;
  font-size: 10px;
  letter-spacing: 1px;
}

#pagina-estagiario .abas {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}

#pagina-estagiario .nav-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px;
  color: #475569;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  transition: background .2s, color .2s;
}

#pagina-estagiario .nav-link:hover {
  color: #174a7e;
  background: #edf4fc;
}

#pagina-estagiario .ic {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

#pagina-estagiario .user {
  display: flex;
  align-items: center;
  gap: 12px;
}

#pagina-estagiario .user-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: right;
}

#pagina-estagiario .user-info strong {
  color: #0a2540;
  font-size: 13px;
}

#pagina-estagiario .user-info span {
  color: #64748b;
  font-size: 11px;
}

#pagina-estagiario .av {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  color: #fff;
  background: #174a7e;
  border-radius: 50%;
  font-weight: 800;
}

#pagina-estagiario .sair {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 40px;
  padding: 9px 12px;
  color: #a12c2c;
  background: #fff4f2;
  border: 1px solid #ffded8;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 700;
}

#pagina-estagiario .cab {
  padding: 58px 24px 78px;
  color: #fff;
  background:
    radial-gradient(circle at 90% 10%, rgba(255,107,0,.2), transparent 28%),
    linear-gradient(125deg, #091f36, #174a7e 70%, #286393);
}

#pagina-estagiario .cab-conteudo {
  width: min(1192px, 100%);
  margin: 0 auto;
}

#pagina-estagiario .cab-label {
  display: inline-block;
  margin-bottom: 16px;
  color: #ffb37d;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.8px;
}

#pagina-estagiario .cab h1 {
  max-width: 780px;
  margin: 0 0 16px;
  color: #fff;
  font-size: clamp(30px, 4vw, 44px);
  line-height: 1.2;
}

#pagina-estagiario .cab p {
  max-width: 720px;
  color: #e2eaf3;
  font-size: 15px;
  line-height: 1.8;
}

#pagina-estagiario .est-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

#pagina-estagiario .est-main {
  width: min(1240px, 100%);
  margin: -34px auto 0;
  padding: 0 24px 56px;
}

#pagina-estagiario .est-loading,
#pagina-estagiario .est-aviso {
  margin-bottom: 24px;
  padding: 22px;
  background: #fff;
  border: 1px solid #e1e8f0;
  border-radius: 14px;
}

#pagina-estagiario .est-aviso--erro {
  color: #9f2929;
  background: #fff1f1;
  border-color: #f6cccc;
}

#pagina-estagiario .est-status {
  padding: 26px;
  background: #fff;
  border: 1px solid #e1e8f0;
  border-top: 4px solid #ff6b00;
  border-radius: 16px;
  box-shadow: 0 10px 28px rgba(10,37,64,.08);
}

#pagina-estagiario .status-conteudo {
  margin-bottom: 22px;
}

#pagina-estagiario .est-status-label,
#pagina-estagiario .section-kicker {
  display: inline-block;
  margin-bottom: 8px;
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

#pagina-estagiario .status-titulo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

#pagina-estagiario .status-titulo h2,
#pagina-estagiario .est-status h2 {
  color: #0a2540;
}

#pagina-estagiario .est-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: #edf4fc;
  border: 1px solid #d7e5f5;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

#pagina-estagiario .est-dot {
  width: 8px;
  height: 8px;
  background: #174a7e;
  border-radius: 50%;
}

#pagina-estagiario .est-progress {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  height: auto;
  overflow: visible;
  margin: 28px 0 4px;
  padding: 0;
  background: transparent;
  list-style: none;
}

#pagina-estagiario .est-step {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  color: #64748b;
  font-size: 12px;
  text-align: center;
}

#pagina-estagiario .est-step-circle {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  background: #edf1f6;
  border: 2px solid #dbe3ec;
  border-radius: 50%;
  font-weight: 800;
}

#pagina-estagiario .est-step.done .est-step-circle {
  color: #fff;
  background: #174a7e;
  border-color: #174a7e;
}

#pagina-estagiario .est-step.active .est-step-circle {
  color: #fff;
  background: #ff6b00;
  border-color: #ff6b00;
}

#pagina-estagiario .est-step.bad .est-step-circle {
  color: #fff;
  background: #b42318;
  border-color: #b42318;
}

#pagina-estagiario .est-section {
  margin-top: 36px;
}

#pagina-estagiario .est-section-head {
  margin-bottom: 20px;
  padding-bottom: 14px;
  border-bottom: 1px solid #dce5ef;
}

#pagina-estagiario .est-section-head h2 {
  margin: 0;
  color: #0a2540;
  font-size: 22px;
}

#pagina-estagiario .est-section-head p {
  margin: 7px 0 0;
  color: #64748b;
  font-size: 14px;
  line-height: 1.7;
}

#pagina-estagiario .est-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

#pagina-estagiario .est-card,
#pagina-estagiario .est-doc,
#pagina-estagiario .est-note,
#pagina-estagiario .est-info,
#pagina-estagiario .est-date {
  min-width: 0;
  padding: 22px;
  background: #fff;
  border: 1px solid #e1e8f0;
  border-radius: 14px;
  box-shadow: 0 8px 24px rgba(10,37,64,.06);
}

#pagina-estagiario .est-card-top {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

#pagina-estagiario .est-card-icon {
  display: grid !important;
  place-items: center;
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  color: #174a7e;
  background: #edf4fc;
  border-radius: 12px;
}

#pagina-estagiario .card-label,
#pagina-estagiario .doc-label {
  display: block;
  margin-bottom: 5px;
  color: #64748b;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

#pagina-estagiario .est-card h3,
#pagina-estagiario .est-doc h3 {
  margin: 0;
  color: #0a2540;
  font-size: 16px;
}

#pagina-estagiario .est-data {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

#pagina-estagiario .est-data-row {
  min-width: 0;
  padding: 13px;
  background: #f8fafd;
  border: 1px solid #e8eef5;
  border-radius: 9px;
}

#pagina-estagiario .est-data-row dt {
  margin-bottom: 6px;
  color: #64748b;
  font-size: 12px;
}

#pagina-estagiario .est-data-row dd {
  margin: 0;
  color: #1b2939;
  font-size: 14px;
  font-weight: 600;
  overflow-wrap: anywhere;
}

#pagina-estagiario .est-data-full {
  grid-column: 1 / -1;
}

#pagina-estagiario .est-bloqueio {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 18px;
  padding: 18px;
  color: #80520b;
  background: #fff8e8;
  border: 1px solid #f3dfae;
  border-radius: 12px;
  font-size: 13px;
  line-height: 1.7;
}

#pagina-estagiario .bloqueio-icon {
  flex-shrink: 0;
}

#pagina-estagiario .est-docs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin: 0;
  padding: 0;
  list-style: none;
}

#pagina-estagiario .est-doc {
  display: flex;
  align-items: stretch;
  gap: 16px;
}

#pagina-estagiario .est-doc-prev {
  display: grid;
  place-items: center;
  min-width: 76px;
  min-height: 90px;
  padding: 12px;
  color: #174a7e;
  background: #edf4fc;
  border-radius: 10px;
}

#pagina-estagiario .doc-type {
  font-size: 13px;
  font-weight: 800;
}

#pagina-estagiario .est-doc-content {
  flex: 1;
  min-width: 0;
}

#pagina-estagiario .est-doc-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

#pagina-estagiario .est-doc-status {
  padding: 6px 9px;
  color: #176344;
  background: #ecfdf5;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

#pagina-estagiario .est-doc p {
  color: #64748b;
  font-size: 13px;
  overflow-wrap: anywhere;
}

#pagina-estagiario .est-doc-ver {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 40px;
  padding: 9px 13px;
  color: #174a7e;
  background: #edf4fc;
  border: 1px solid #d7e5f5;
  border-radius: 8px;
  font-weight: 700;
}

#pagina-estagiario .est-hist {
  margin: 0;
  padding: 8px 22px;
  background: #fff;
  border: 1px solid #e1e8f0;
  border-radius: 14px;
  list-style: none;
}

#pagina-estagiario .hist-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 18px 0;
  border-bottom: 1px solid #edf1f6;
}

#pagina-estagiario .hist-item:last-child {
  border-bottom: 0;
}

#pagina-estagiario .hist-marker {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  flex-shrink: 0;
  color: #fff;
  background: #174a7e;
  border-radius: 50%;
}

#pagina-estagiario .hist-bad .hist-marker {
  background: #b42318;
}

#pagina-estagiario .hist-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 5px;
}

#pagina-estagiario .hist-content strong {
  color: #0a2540;
  font-size: 14px;
}

#pagina-estagiario .hist-content span,
#pagina-estagiario .hist-item time {
  color: #64748b;
  font-size: 12px;
  line-height: 1.6;
}

#pagina-estagiario .est-info {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(220px, .55fr);
  gap: 20px;
}

#pagina-estagiario .est-note {
  display: flex;
  gap: 14px;
  box-shadow: none;
}

#pagina-estagiario .note-icon {
  color: #174a7e;
  flex-shrink: 0;
}

#pagina-estagiario .est-date {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12px;
  background: #f8fafd;
  box-shadow: none;
}

#pagina-estagiario .est-date > span {
  color: #64748b;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

#pagina-estagiario .est-date time {
  color: #0a2540;
  font-size: 24px;
  font-weight: 800;
}

#pagina-estagiario .est-date small {
  color: #64748b;
  line-height: 1.6;
}

#pagina-estagiario .rodape {
  padding: 40px 24px 0;
  color: #cbd5e1;
  background: #091f36;
}

#pagina-estagiario .rodape-in {
  display: grid;
  grid-template-columns: 1.3fr 1fr .7fr;
  gap: 36px;
  padding-bottom: 32px;
}

#pagina-estagiario .rodape-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #fff;
  font-weight: 800;
}

#pagina-estagiario .rodape-logo img {
  max-width: 120px;
  max-height: 42px;
  object-fit: contain;
}

#pagina-estagiario .rodape-brand p {
  max-width: 330px;
  color: #cbd5e1;
  font-size: 13px;
  line-height: 1.8;
}

#pagina-estagiario .rodape h2 {
  margin: 0 0 18px;
  color: #fff;
  font-size: 16px;
}

#pagina-estagiario .rodape-contacto {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

#pagina-estagiario .rodape-contacto div:last-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

#pagina-estagiario .rodape-contacto span {
  color: #94a3b8;
  font-size: 12px;
}

#pagina-estagiario .rodape-links ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

#pagina-estagiario .rodape-links li {
  margin-bottom: 12px;
}

#pagina-estagiario .rodape-links a {
  color: #cbd5e1;
  text-decoration: none;
}

#pagina-estagiario .rodape-links a:hover {
  color: #ffb37d;
}

#pagina-estagiario .rodape-fim {
  margin: 0 -24px;
  padding: 18px 24px;
  color: #94a3b8;
  border-top: 1px solid rgba(255,255,255,.12);
  text-align: center;
  font-size: 12px;
}

#pagina-estagiario button:focus-visible,
#pagina-estagiario a:focus-visible {
  outline: 3px solid #ff9a45;
  outline-offset: 3px;
}

@media (max-width: 1000px) {
  #pagina-estagiario .barra-conteudo {
    flex-wrap: wrap;
    justify-content: center;
    padding: 16px 0;
  }

  #pagina-estagiario .abas {
    flex-wrap: wrap;
    justify-content: center;
  }

  #pagina-estagiario .est-info {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  #pagina-estagiario .barra {
    padding: 0 16px;
  }

  #pagina-estagiario .marca {
    margin-right: auto;
  }

  #pagina-estagiario .user {
    flex-wrap: wrap;
    justify-content: center;
  }

  #pagina-estagiario .user-info {
    text-align: left;
  }

  #pagina-estagiario .cab {
    padding: 38px 20px 58px;
  }

  #pagina-estagiario .est-main {
    padding: 0 14px 40px;
  }

  #pagina-estagiario .est-grid,
  #pagina-estagiario .est-docs,
  #pagina-estagiario .est-data,
  #pagina-estagiario .rodape-in {
    grid-template-columns: 1fr;
  }

  #pagina-estagiario .est-doc {
    flex-direction: column;
  }

  #pagina-estagiario .est-doc-prev {
    min-height: 64px;
  }

  #pagina-estagiario .est-progress {
    gap: 4px;
  }

  #pagina-estagiario .est-step {
    font-size: 10px;
  }

  #pagina-estagiario .est-status,
  #pagina-estagiario .est-card,
  #pagina-estagiario .est-doc,
  #pagina-estagiario .est-note,
  #pagina-estagiario .est-date {
    padding: 16px;
  }

  #pagina-estagiario .hist-item {
    flex-wrap: wrap;
  }

  #pagina-estagiario .rodape {
    padding: 32px 18px 0;
  }
}


/* PALETA UNIFICADA  MULTITEL */
#pagina-estagiario .cab {
  background:
    radial-gradient(circle at 90% 10%, rgba(255,255,255,.08), transparent 28%),
    linear-gradient(125deg, #091f36, #174a7e 70%, #286393);
}

#pagina-estagiario .cab-label {
  color: #d7e5f5;
}

#pagina-estagiario .est-status {
  border-top-color: #174a7e;
}

#pagina-estagiario .est-dot {
  background: #174a7e;
}

#pagina-estagiario .est-step.active .est-step-circle {
  color: #fff;
  background: #174a7e;
  border-color: #174a7e;
}

#pagina-estagiario .est-step.done .est-step-circle {
  color: #fff;
  background: #286393;
  border-color: #286393;
}

#pagina-estagiario .est-card-icon,
#pagina-estagiario .est-doc-prev,
#pagina-estagiario .note-icon {
  color: #174a7e;
  background-color: #edf4fc;
}

#pagina-estagiario .est-bloqueio {
  color: #475569;
  background: #f4f7fb;
  border-color: #dbe3ec;
}

#pagina-estagiario .est-bloqueio svg {
  color: #174a7e;
}

#pagina-estagiario .est-doc-status {
  color: #176344;
  background: #ecfdf5;
}

#pagina-estagiario .est-doc-ver {
  color: #174a7e;
  background: #edf4fc;
  border-color: #d7e5f5;
}

#pagina-estagiario .est-doc-ver:hover {
  color: #fff;
  background: #174a7e;
}

#pagina-estagiario .est-step.bad .est-step-circle {
  background: #b42318;
  border-color: #b42318;
}

#pagina-estagiario .est-step.active .est-step-circle,
#pagina-estagiario .est-step.done .est-step-circle {
  box-shadow: none;
}

#pagina-estagiario .rodape-links a:hover {
  color: #fff;
}

#pagina-estagiario .est-hero-actions .est-btn-primary {
  color: #fff;
  background: #174a7e;
  border-color: #174a7e;
}

#pagina-estagiario .est-hero-actions .est-btn-primary:hover {
  background: #0a2540;
  border-color: #0a2540;
}

#pagina-estagiario .est-hero-actions .est-btn-light {
  color: #174a7e;
  background: #fff;
  border-color: #fff;
}

#pagina-estagiario .est-hero-actions .est-btn-light:hover {
  background: #edf4fc;
  border-color: #edf4fc;
}

#pagina-estagiario .cab-label,
#pagina-estagiario .est-status,
#pagina-estagiario .est-card,
#pagina-estagiario .est-doc,
#pagina-estagiario .est-note,
#pagina-estagiario .est-date {
  --cor-multitel: #174a7e;
}



/* Estado da candidatura  azul Multitel */
#pagina-estagiario .est-badge {
  color: #174a7e;
  background: #edf4fc;
  border-color: #d7e5f5;
}

#pagina-estagiario .est-badge .est-dot {
  background: #174a7e;
}
