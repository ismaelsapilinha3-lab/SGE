:host {
  display: block;
  min-height: 100%;
  color: #1b2939;
  background: #f4f7fb;

  --azul: #0a2540;
  --azul-medio: #174a7e;
  --azul-claro: #edf4fc;
  --laranja: #ff6b00;
  --fundo: #f4f7fb;
  --borda: #e1e8f0;
  --texto: #1b2939;
  --texto-suave: #64748b;
  --branco: #ffffff;
  --sombra: 0 8px 24px rgba(10, 37, 64, 0.07);
}

* {
  box-sizing: border-box;
}

button,
a,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  cursor: pointer;
}

.est-topbar {
  width: 100%;
  background: var(--branco);
  border-bottom: 1px solid var(--borda);
}

.est-navbar {
  width: min(1240px, 100%);
  min-height: 76px;
  margin: 0 auto;
  padding: 14px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.est-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--azul);
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -0.4px;
}

.est-brand img {
  display: block;
  width: auto;
  max-width: 150px;
  max-height: 48px;
  object-fit: contain;
}

.est-navlinks {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex-wrap: wrap;
}

.est-navlinks a,
.est-navlinks button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 9px 13px;
  color: #475569;
  background: transparent;
  border: 0;
  border-radius: 9px;
  font-size: 14px;
  font-weight: 600;
  transition: background 0.2s ease, color 0.2s ease;
}

.est-navlinks a:hover,
.est-navlinks button:hover {
  color: var(--azul);
  background: var(--azul-claro);
}

.est-user {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--azul);
  font-size: 14px;
  font-weight: 700;
}

.est-user img {
  width: 42px;
  height: 42px;
  object-fit: cover;
  border: 2px solid #e5edf6;
  border-radius: 50%;
}

.est-logout {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 10px 15px;
  color: #a12c2c;
  background: #fff4f2;
  border: 1px solid #ffded8;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 700;
  transition: background 0.2s ease, transform 0.2s ease;
}

.est-logout:hover {
  background: #ffe8e3;
  transform: translateY(-1px);
}

.est-hero {
  position: relative;
  overflow: hidden;
  padding: 64px 24px 82px;
  color: var(--branco);
  background:
    radial-gradient(circle at 90% 10%, rgba(255, 107, 0, 0.18), transparent 28%),
    linear-gradient(125deg, #091f36 0%, #174a7e 65%, #286393 100%);
}

.est-hero::after {
  position: absolute;
  right: -90px;
  bottom: -170px;
  width: 360px;
  height: 360px;
  content: "";
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  pointer-events: none;
}

.est-hero > * {
  position: relative;
  z-index: 1;
}

.est-hero h1 {
  max-width: 760px;
  margin: 0 0 16px;
  color: var(--branco);
  font-size: clamp(30px, 4vw, 44px);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.8px;
}

.est-hero p {
  max-width: 680px;
  margin: 0;
  color: rgba(255, 255, 255, 0.85);
  font-size: 16px;
  line-height: 1.8;
}

.est-hero .est-btn-primary {
  margin-top: 24px;
}

.est-main {
  position: relative;
  z-index: 2;
  width: min(1240px, 100%);
  margin: -38px auto 0;
  padding: 0 24px 60px;
}

.est-status {
  padding: 28px;
  background: var(--branco);
  border: 1px solid #e5ebf2;
  border-top: 4px solid var(--laranja);
  border-radius: 16px;
  box-shadow: 0 12px 32px rgba(10, 37, 64, 0.09);
}

.est-status h2,
.est-status h3 {
  margin-top: 0;
  color: var(--azul);
}

.est-status p {
  color: var(--texto-suave);
  line-height: 1.7;
}

.est-progress {
  width: 100%;
  height: 9px;
  overflow: hidden;
  margin: 16px 0;
  background: #e8eef5;
  border-radius: 99px;
}

.est-progress > * {
  height: 100%;
  background: linear-gradient(90deg, var(--laranja), #ff9a45);
  border-radius: inherit;
}

.est-section {
  margin-top: 38px;
}

.est-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
  padding-bottom: 14px;
  border-bottom: 1px solid #dce5ef;
}

.est-section-head h2 {
  margin: 0;
  color: var(--azul);
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -0.35px;
}

.est-section-head p {
  margin: 6px 0 0;
  color: var(--texto-suave);
  font-size: 14px;
  line-height: 1.6;
}

.est-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.est-card,
.est-doc,
.est-note,
.est-info {
  min-width: 0;
  padding: 24px;
  background: var(--branco);
  border: 1px solid var(--borda);
  border-radius: 14px;
  box-shadow: var(--sombra);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.est-card:hover,
.est-doc:hover,
.est-note:hover,
.est-info:hover {
  transform: translateY(-2px);
  border-color: #cbd9e8;
  box-shadow: 0 12px 28px rgba(10, 37, 64, 0.1);
}

.est-card h3,
.est-doc h3,
.est-note h3,
.est-info h3 {
  margin: 0 0 10px;
  color: var(--azul);
  font-size: 17px;
  font-weight: 750;
  line-height: 1.45;
}

.est-card p,
.est-doc p,
.est-note p,
.est-info p {
  margin: 0 0 14px;
  color: var(--texto-suave);
  font-size: 14px;
  line-height: 1.75;
  overflow-wrap: anywhere;
}

.est-card-icon,
.est-doc-icon,
.est-bloqueio svg {
  display: none !important;
}

.est-data {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.est-data > div {
  min-width: 0;
  padding: 16px;
  background: #f8fafd;
  border: 1px solid #e8eef5;
  border-radius: 10px;
}

.est-data strong,
.est-data b {
  display: block;
  margin-bottom: 6px;
  color: var(--azul);
  font-size: 13px;
}

.est-data span,
.est-data p {
  color: #526276;
  font-size: 14px;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.est-docs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.est-doc {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12px;
}

.est-doc-prev {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 110px;
  padding: 18px;
  color: var(--azul-medio);
  text-align: center;
  background: linear-gradient(145deg, #edf4fc, #f8faff);
  border: 1px solid #e2eaf4;
  border-radius: 10px;
}

.est-doc-open,
.est-doc-ver {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 10px 15px;
  color: var(--azul-medio);
  background: #edf4fc;
  border: 1px solid #d7e5f5;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
  transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

.est-doc-open:hover,
.est-doc-ver:hover {
  color: var(--azul);
  background: #dceafb;
  transform: translateY(-1px);
}

.est-btn-primary,
.est-btn-light {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 12px 19px;
  border: 1px solid transparent;
  border-radius: 9px;
  font-size: 14px;
  font-weight: 750;
  text-align: center;
  text-decoration: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.est-btn-primary {
  color: var(--branco);
  background: var(--laranja);
  border-color: var(--laranja);
  box-shadow: 0 5px 14px rgba(255, 107, 0, 0.18);
}

.est-btn-primary:hover {
  background: #e85f00;
  box-shadow: 0 8px 18px rgba(255, 107, 0, 0.24);
  transform: translateY(-1px);
}

.est-btn-light {
  color: var(--azul);
  background: var(--branco);
  border-color: #d5e0ec;
}

.est-btn-light:hover {
  background: #f0f5fb;
  transform: translateY(-1px);
}

.est-hist {
  padding: 8px 24px;
  background: var(--branco);
  border: 1px solid var(--borda);
  border-radius: 14px;
  box-shadow: var(--sombra);
}

.est-hist ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.est-hist li {
  position: relative;
  padding: 18px 0 18px 24px;
  color: #526276;
  border-bottom: 1px solid #edf1f6;
  font-size: 14px;
  line-height: 1.7;
}

.est-hist li:last-child {
  border-bottom: 0;
}

.est-hist li::before {
  position: absolute;
  top: 25px;
  left: 0;
  width: 9px;
  height: 9px;
  content: "";
  background: var(--laranja);
  border-radius: 50%;
}

.est-footer {
  padding: 28px 24px;
  color: #cbd5e1;
  background: #091f36;
  text-align: center;
  font-size: 13px;
  line-height: 1.8;
}

.est-footer p {
  margin: 0;
}

.est-footer a {
  color: var(--branco);
  text-decoration: none;
}

.est-footer a:hover {
  color: #ffb37d;
}

.est-bloqueio {
  padding: 18px;
  color: #80520b;
  background: #fff8e8;
  border: 1px solid #f3dfae;
  border-radius: 10px;
  font-size: 14px;
  line-height: 1.7;
}

.est-success {
  color: #176344;
  background: #ecfdf5;
  border-color: #b9efd4;
}

.est-warning {
  color: #80520b;
  background: #fff8e8;
  border-color: #f3dfae;
}

.est-error {
  color: #9f2929;
  background: #fff1f1;
  border-color: #f6cccc;
}

.est-muted {
  color: var(--texto-suave);
}

.est-status a,
.est-section a {
  text-decoration: none;
}

:host button:focus-visible,
:host a:focus-visible,
:host input:focus-visible,
:host select:focus-visible,
:host textarea:focus-visible {
  outline: 3px solid rgba(255, 107, 0, 0.75);
  outline-offset: 3px;
}

@media (max-width: 900px) {
  .est-navbar {
    flex-wrap: wrap;
    justify-content: center;
  }

  .est-brand {
    margin-right: auto;
  }

  .est-navlinks {
    order: 3;
    width: 100%;
  }

  .est-user {
    margin-left: auto;
  }

  .est-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 650px) {
  .est-navbar {
    min-height: 64px;
    padding: 12px 16px;
    gap: 12px;
  }

  .est-brand {
    font-size: 16px;
  }

  .est-brand img {
    max-width: 120px;
    max-height: 40px;
  }

  .est-user {
    gap: 8px;
    font-size: 12px;
  }

  .est-user img {
    width: 36px;
    height: 36px;
  }

  .est-navlinks {
    justify-content: flex-start;
    gap: 4px;
  }

  .est-navlinks a,
  .est-navlinks button {
    min-height: 38px;
    padding: 8px 10px;
    font-size: 12px;
  }

  .est-hero {
    padding: 38px 20px 58px;
  }

  .est-hero h1 {
    font-size: clamp(27px, 7vw, 36px);
  }

  .est-hero p {
    font-size: 14px;
  }

  .est-main {
    margin-top: -24px;
    padding: 0 14px 40px;
  }

  .est-status {
    padding: 20px;
  }

  .est-section {
    margin-top: 30px;
  }

  .est-section-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .est-section-head h2 {
    font-size: 19px;
  }

  .est-grid,
  .est-docs,
  .est-data {
    grid-template-columns: 1fr;
  }

  .est-card,
  .est-doc,
  .est-note,
  .est-info {
    padding: 18px;
  }

  .est-hist {
    padding: 6px 18px;
  }

  .est-btn-primary,
  .est-btn-light {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
    animation: none !important;
  }
}
