<section id="pagina-estagiario">
  <div class="est-topbar">
    <span>Portal de Estágios Multitel</span>
    <span>Linha de apoio: 223 530 000 <span class="est-separador">·</span> Dias úteis</span>
  </div>

  <nav class="est-navbar" aria-label="Navegação do portal do estagiário">
    <a class="est-brand" href="#est-inicio" aria-label="Multitel — início do portal">
      <img class="est-brand-logo" src="assets/img/multitel.png" alt="Logo Multitel" />
      <span class="est-brand-text"><strong>MULTITEL</strong><small>PORTAL DE ESTÁGIOS</small></span>
    </a>

    <div class="est-navlinks">
      <a href="#est-inicio">Início</a>
      <a href="#est-perfil">Meu perfil</a>
      <a href="#est-documentos">Documentos</a>
      <a href="#est-acompanhamento">Acompanhamento</a>
    </div>

    <div class="est-user">
      <span class="est-user-name">Olá, {{ primeiroNome() }}</span>
      <span class="est-avatar" aria-label="Inicial do estagiário">{{ inicial() }}</span>
      <button type="button" class="est-logout" (click)="sair()">Sair</button>
    </div>
  </nav>

  <header class="est-hero" id="est-inicio">
    <div class="est-hero-inner">
      <span class="est-kicker">Área pessoal do estagiário</span>
      <h1>Bem-vindo, <span>{{ primeiroNome() }}</span>!</h1>
      <p>Acompanha num único espaço o teu processo de estágio, consulta os teus dados, verifica os documentos enviados e acompanha a evolução da candidatura.</p>
      <div class="est-hero-actions">
        <a class="est-btn-primary" href="#est-acompanhamento">Ver estado do processo</a>
        <a class="est-btn-light" href="#est-documentos">Consultar documentos</a>
      </div>
    </div>
  </header>

  <main class="est-main">
    <div *ngIf="carregando()" class="est-feedback est-feedback-loading" role="status" aria-live="polite">
      <span class="est-spinner" aria-hidden="true"></span>
      <div><strong>A carregar o teu processo</strong><p>Estamos a consultar os dados da candidatura.</p></div>
    </div>

    <div *ngIf="erro() as mensagemErro" class="est-feedback est-feedback-error" role="alert">
      <div><strong>Não foi possível apresentar o processo</strong><p>{{ mensagemErro }}</p></div>
      <button type="button" class="est-btn-outline" (click)="recarregar()">Tentar novamente</button>
    </div>

    <div *ngIf="!carregando() && !erro() && !candidatura()" class="est-feedback" role="status">
      <div><strong>Não encontrámos uma candidatura</strong><p>Quando existir uma candidatura associada à tua conta, os dados serão apresentados aqui.</p></div>
      <button type="button" class="est-btn-outline" (click)="recarregar()">Verificar novamente</button>
    </div>

    <ng-container *ngIf="candidatura() as dados">
      <section class="est-status" id="est-acompanhamento" [attr.data-estado]="dados.estado || 'analise'" aria-labelledby="est-estado-titulo">
        <div class="est-status-summary">
          <span class="est-status-label">Estado atual</span>
          <h2 id="est-estado-titulo">{{ estado().titulo }}</h2>
          <p>{{ texto() }}</p>
          <span class="est-badge"><i class="est-dot"></i><b>{{ estado().badge }}</b></span>
        </div>
        <div class="est-progress">
          <div class="est-step done"><div class="est-step-circle">✓</div><span>Candidatura submetida</span></div>
          <div class="est-step" [class.active]="estado().p2 === 'active'" [class.done]="estado().p2 === 'done'">
            <div class="est-step-circle">{{ estado().p2 === 'done' ? '✓' : '2' }}</div><span>Em análise</span>
          </div>
          <div class="est-step" [class.done]="estado().p3 === 'done'" [class.bad]="estado().p3 === 'bad'">
            <div class="est-step-circle">{{ estado().c3 }}</div><span>{{ estado().l3 }}</span>
          </div>
        </div>
      </section>

      <section class="est-section" id="est-perfil" aria-labelledby="est-perfil-titulo">
        <div class="est-section-head"><div><h2 id="est-perfil-titulo">O teu perfil</h2><p>Dados associados à tua candidatura.</p></div></div>
        <div class="est-grid">
          <article class="est-card">
            <div class="est-card-icon" aria-hidden="true"><svg fill="none" height="20" stroke="#1A3D6B" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6"></path></svg></div>
            <h3>Dados pessoais</h3>
            <div class="est-data">
              <div class="est-data-row"><span>Nome completo</span><strong>{{ dados.nome || 'Não informado' }}</strong></div>
              <div class="est-data-row"><span>BI</span><strong>{{ dados.bi || 'Não informado' }}</strong></div>
              <div class="est-data-row"><span>Contacto</span><strong>{{ dados.contacto || 'Não informado' }}</strong></div>
              <div class="est-data-row"><span>Email</span><strong>{{ dados.email || 'Não informado' }}</strong></div>
              <div class="est-data-row"><span>Data de nascimento</span><strong>{{ formatarData(dados.nascimento) }}</strong></div>
              <div class="est-data-row"><span>Sexo</span><strong>{{ dados.sexo || 'Não informado' }}</strong></div>
            </div>
          </article>

          <article class="est-card">
            <div class="est-card-icon" aria-hidden="true"><svg fill="none" height="20" stroke="#1A3D6B" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="m2 9 10-5 10 5-10 5z"></path><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"></path></svg></div>
            <h3>Dados académicos</h3>
            <div class="est-data">
              <div class="est-data-row"><span>Curso</span><strong>{{ dados.curso || 'Não informado' }}</strong></div>
              <div class="est-data-row"><span>Instituição</span><strong>{{ dados.universidade || 'Não informado' }}</strong></div>
              <div class="est-data-row"><span>Área pretendida</span><strong>Conforme candidatura</strong></div>
              <div class="est-data-row"><span>Departamento</span><strong>{{ dados.departamento || 'A definir' }}</strong></div>
              <div class="est-data-row"><span>Data de submissão</span><strong>{{ formatarData(dados.data_submissao) }}</strong></div>
            </div>
          </article>
        </div>
      </section>

      <section class="est-section" id="est-documentos" aria-labelledby="est-documentos-titulo">
        <div class="est-section-head"><div><h2 id="est-documentos-titulo">Os teus documentos</h2><p>Documentos associados ao processo de candidatura.</p></div></div>
        <div class="est-bloqueio"><svg aria-hidden="true" viewBox="0 0 24 24"><rect height="9" rx="2" width="14" x="5" y="11"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg><span>Os documentos submetidos ficam disponíveis para consulta. Para corrigir alguma informação, contacta a equipa responsável pelo processo.</span></div>
        <div class="est-docs" *ngIf="dados.documentos?.length; else semDocumentos">
          <article class="est-doc" *ngFor="let documento of dados.documentos">
            <div class="est-doc-top"><div class="est-doc-icon">{{ extensao(documento) }}</div><span class="est-doc-status" [attr.data-estado]="documento.estado || 'recebido'">{{ rotuloEstadoDocumento(documento) }}</span></div>
            <h3>{{ tituloDocumento(documento) }}</h3>
            <p class="est-doc-file" [title]="documento.nome_arquivo">{{ documento.nome_arquivo || 'Ficheiro sem nome' }}</p>
            <p class="est-doc-date">Enviado: {{ formatarData(documento.data_upload) }}</p>
            <button type="button" class="est-doc-open" (click)="ver(documento)" [attr.aria-label]="'Consultar ' + tituloDocumento(documento)">Consultar documento <span aria-hidden="true">→</span></button>
          </article>
        </div>
        <ng-template #semDocumentos><div class="est-empty-docs"><span class="est-empty-icon" aria-hidden="true">PDF</span><div><strong>Não existem documentos para apresentar</strong><p>Os ficheiros aparecerão aqui quando estiverem associados à tua candidatura.</p></div></div></ng-template>
      </section>

      <section class="est-section" id="est-historico" aria-labelledby="est-historico-titulo">
        <div class="est-section-head"><div><h2 id="est-historico-titulo">Histórico do processo</h2><p>Cada etapa da tua candidatura, por ordem.</p></div></div>
        <ol class="est-hist" *ngIf="historico().length; else semHistorico">
          <li *ngFor="let etapa of historico()" [class.feito]="etapa.classe === 'done'" [class.atual]="etapa.classe === 'active'" [class.bad]="etapa.classe === 'bad'">
            <i aria-hidden="true">{{ etapa.icone }}</i>
            <div><strong>{{ etapa.titulo }}</strong><span>{{ etapa.texto }}</span></div>
            <time>{{ formatarData(etapa.data) }}</time>
          </li>
        </ol>
        <ng-template #semHistorico><div class="est-empty-history">O histórico será apresentado quando existirem etapas registadas.</div></ng-template>
      </section>

      <section class="est-section">
        <div class="est-info">
          <article class="est-note"><h3>Precisas de ajuda?</h3><p>Para esclarecimentos sobre o estado da candidatura ou os documentos apresentados, contacta a linha de apoio da Multitel, nos dias úteis.</p><a href="tel:223530000">223 530 000</a></article>
          <article class="est-date"><small>DATA DA CANDIDATURA</small><strong>{{ formatarData(dados.data_submissao) }}</strong><span>Departamento: {{ dados.departamento || 'A definir' }}</span></article>
        </div>
      </section>
    </ng-container>
  </main>

  <footer class="est-footer"><span>© 2026 <strong>Multitel, S.A.</strong> Todos os direitos reservados.</span><span>Portal de Estágios</span><a href="https://www.multitel.co.ao" target="_blank" rel="noopener noreferrer">Site institucional <span aria-hidden="true">↗</span></a></footer>
</section>
