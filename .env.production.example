APP_NAME="SGE MULTITEL"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sge.exemplo.ao
# URL pública do portal Angular, usada nos links de e-mail.
FRONTEND_URL=https://sge.exemplo.ao

# Política de Segurança de Conteúdos. Ativar e validar em produção.
CSP_ENABLED=true
CSP_REPORT_ONLY=false

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sge_multitel
DB_USERNAME=sge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database

# Backups diários da base de dados e dos ficheiros.
# A pasta deve ter espaço suficiente e ser copiada para fora do servidor.
BACKUP_ENABLED=true
BACKUP_PATH=/var/backups/sge
BACKUP_KEEP_DAYS=30
DB_DUMP_BINARY=mysqldump

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.exemplo.ao
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sge@exemplo.ao"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NOME="Administrador SGE"
ADMIN_EMAIL="admin@exemplo.ao"
ADMIN_PASSWORD=

# Origens exactas autorizadas a falar com a API.
CORS_ALLOWED_ORIGINS=https://sge.exemplo.ao
CORS_ALLOWED_ORIGIN_PATTERNS=

SANCTUM_EXPIRATION=43200

# Indique os IPs do proxy reverso, separados por vírgula.
# Exemplo: TRUSTED_PROXIES=127.0.0.1,10.0.0.10
TRUSTED_PROXIES=

SMS_ENABLED=true
SMS_PROVIDER=http
SMS_FROM="MULTITEL"
SMS_COUNTRY_CODE="+244"
SMS_ENDPOINT=
SMS_HTTP_METHOD=POST
SMS_AUTH=bearer
SMS_API_KEY=
SMS_API_SECRET=
SMS_AUTH_HEADER=Authorization
SMS_AUTH_SCHEME=Bearer
SMS_AUTH_QUERY_PARAM=api_key
SMS_CAMPO_DESTINO=to
SMS_CAMPO_MENSAGEM=text
SMS_CAMPO_REMETENTE=from
SMS_FORMATO_NUMERO=internacional
SMS_CAMPOS_EXTRA=
SMS_CAMPO_REFERENCIA=id
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
